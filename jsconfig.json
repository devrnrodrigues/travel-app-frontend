{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@config/*": ["./src/config/*"],
      "@features/*": ["./src/features/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@shared/*": ["./src/shared/*"],
      "@theme/*": ["./src/theme/*"]
    }
  },
  "exclude": [
    "node_modules",
    ".expo"
  ]
}
